{
  "manifest_version": 3,
  "name": "DNSentinel",
  "version": "1.0",
  "description": "Monitors domains in real-time for potentially suspicious DNS activity and warns you before visiting high-risk sites.",
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://*/*",
    "https://*/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["warning.html", "warning.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
