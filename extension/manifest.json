{
  "manifest_version": 3,
  "name": "DNSentinel",
  "version": "2.0",
  "description": "Real-time DNS anomaly detection. Highlights suspicious links, shows risk scores, and warns before entering high-risk domains.",
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "tabs",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["warning.html", "warning.js", "content.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
