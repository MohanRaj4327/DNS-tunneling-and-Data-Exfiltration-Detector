{
  "manifest_version": 3,
  "name": "DNSentinel",
  "version": "1.0",
  "description": "Monitors current domains for potentially suspicious DNS activity.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*"
  ]
}
